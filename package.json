{
  "name": "far-away-from-codex",
  "displayName": "Far Away From Codex",
  "description": "Get Telegram alerts when Codex finishes, fails, or needs your approval while you're away from VS Code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
"activationEvents": [
  "onStartupFinished"
],  "main": "./out/extension.js",
  "contributes": {
  "commands": [
    {
      "command": "far-away-from-codex.toggleAlerts",
      "title": "Codex Alerts: Toggle"
    },
    {
      "command": "far-away-from-codex.testNotification",
      "title": "Far Away From Codex: Test Notification"
    },
    {
      "command": "far-away-from-codex.connectTelegram",
      "title": "Far Away From Codex: Connect Telegram"
    },
    {
      "command": "far-away-from-codex.disconnectTelegram",
      "title": "Far Away From Codex: Disconnect Telegram"
    }
  ]
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
