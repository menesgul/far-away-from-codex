{
  "name": "far-away-from-codex-workspace",
  "private": true,
  "workspaces": [
    "apps/vscode",
    "apps/cloud",
    "apps/companion",
    "packages/domain",
    "packages/contracts",
    "packages/agent-adapter-sdk",
    "packages/windows-ipc-security"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "watch": "npm run watch --workspace=far-away-from-codex",
    "extension:compile": "npm run compile --workspace=far-away-from-codex",
    "extension:lint": "npm run lint --workspace=far-away-from-codex",
    "extension:test": "npm run extension:test --workspace=far-away-from-codex",
    "cloud:typecheck": "npm run typecheck --workspace=far-away-from-codex-worker",
    "cloud:test": "npm run test --workspace=far-away-from-codex-worker",
    "domain:typecheck": "npm run typecheck --workspace=@far-away/domain",
    "contracts:typecheck": "npm run typecheck --workspace=@far-away/contracts",
    "adapter-sdk:typecheck": "npm run typecheck --workspace=@far-away/agent-adapter-sdk",
    "companion:build": "npm run build --workspace=@far-away/companion",
    "windows-ipc-security:build": "npm run build --workspace=@far-away/windows-ipc-security",
    "companion:typecheck": "npm run typecheck --workspace=@far-away/companion",
    "companion:test": "npm run test --workspace=@far-away/companion",
    "worker:typecheck": "npm run cloud:typecheck",
    "worker:test": "npm run cloud:test",
    "validate": "npm run domain:typecheck && npm run contracts:typecheck && npm run adapter-sdk:typecheck && npm run windows-ipc-security:build && npm run companion:build && npm run companion:typecheck && npm run companion:test && npm run extension:compile && npm run extension:lint && npm run extension:test && npm run cloud:typecheck && npm run cloud:test"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
